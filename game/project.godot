; Configurazione del progetto Godot. Tutte le chiavi sono esplicite:
; i progetti nuovi di Godot 4.7 partono con canvas_items/expand, qui servono viewport/keep/integer.

config_version=5

[application]

config/name="CTRL+ALT REVENGE"
config/description="Picchia duro a scorrimento. 2087."
config/version="0.1.0-slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/max_fps=0
run/low_processor_mode=false
boot_splash/bg_color=Color(0.071, 0.059, 0.141, 1)
boot_splash/show_image=false

[autoload]

Controls="*res://src/core/controls.gd"
Game="*res://src/core/game.gd"
Sfx="*res://src/audio/sfx.gd"
Music="*res://src/audio/music_director.gd"
AttackDirector="*res://src/combat/attack_director.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[editor]

movie_writer/fps=60
movie_writer/mix_rate=48000

[input_devices]

buffering/agile_event_flushing=false

[physics]

2d/physics_engine="GodotPhysics2D"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.5
common/physics_interpolation=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=true
rendering_device/fallback_to_opengl3=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.071, 0.059, 0.141, 1)
